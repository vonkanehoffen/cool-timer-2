; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gems"
config/description="Falling gems sandbox — tap to spawn."
run/main_scene="res://scenes/sandbox/falling_gems_sandbox.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/icon.svg"

[audio]

general/default_playback_type.web=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[physics]

2d/sleep_threshold_linear=4.0
2d/sleep_threshold_angular=0.35
common/physics_ticks_per_second=30

[rendering]

environment/defaults/default_clear_color=Color(0, 0, 0, 1)
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
